flowchart LR
    subgraph P1["Part 1: build_graph() - runs once per question, no saving"]
        direction LR
        S(["start"]) --> C["classify<br/>guard the request,<br/>find the company"]
        C -->|"no company"| E1(["end: company_not_found"])
        C --> EV["evidence<br/>CRM facts, deals,<br/>interactions"]
        EV --> DO["documents<br/>search the ingested<br/>documents"]
        DO --> AN["analyze<br/>Analyst agent"]
        AN --> RV["review<br/>Reviewer agent"]
        RV -->|"approved, or out of revisions"| DR["draft<br/>Task Drafter agent,<br/>output guard"]
        RV -->|"revise (once)"| PR["prepare_revision"]
        PR --> AN
    end
    subgraph P2["Part 2: build_approval_graph() - saved in Postgres under a derived thread id"]
        direction LR
        HA["human_approval<br/>interrupt(): the run stops<br/>and is saved here"] -->|"confirm = true"| W["write<br/>creates the task"]
        HA -->|"confirm = false"| E3(["end: declined"])
        W --> E4(["end: confirmed"])
    end
    DR -->|"thread id = company + note"| HA
    classDef new fill:#a5d6a7,stroke:#1b5e20,stroke-width:2px,color:#0d3b12
    classDef chg fill:#fff59d,stroke:#f9a825,stroke-width:2px,color:#4e3b00
    class C,EV,DO,AN,RV,PR,DR chg
    class HA,W new
