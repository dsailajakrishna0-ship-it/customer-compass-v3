# Copy this file to apps/api-py/.env and fill in the values you need.
# apps/api-py/.env is gitignored — never commit real secrets.

# --- Database ----------------------------------------------------------------
# Same Postgres instance as the Express API (apps/api) — structured/
# relational data only (companies, deals, contacts, interactions). Vector
# storage for this service is Qdrant, configured separately once retrieval
# is ported over in a later PR.
# DATABASE_URL=postgresql://customer_compass:customer_compass_dev@localhost:5432/customer_compass

# --- Qdrant (vector store for document chunks, PR 3) ------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=document_chunks

# --- Google AI Studio (embeddings, PR 3) ------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Note: Google retired "text-embedding-004" (originally planned for this
# migration); this service uses "gemini-embedding-001" instead, requesting a
# 768-dim output via outputDimensionality (Matryoshka representation
# learning) to match Qdrant's configured vector size.
# GOOGLE_API_KEY=
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# --- Sample data (only needed if running outside Docker Compose) -----------
# Absolute path override for the ingestion pipeline's document source
# directory. Defaults to <repo>/sample-data/documents when unset (resolved
# relative to app/rag/ingest.py). Docker Compose sets this explicitly since
# the container image only contains apps/api-py, not the whole repo.
# SAMPLE_DATA_DIR=

# --- LLM provider (chat/RAG/CRM routes, PR 4) -------------------------------
# "ollama" (default, local/free) or "cloud" (OpenRouter). A request can also
# override this per-call via the "provider" field in the request body.
# LLM_PROVIDER=ollama

# --- Ollama (local LLM, PR 4) ------------------------------------------------
# OLLAMA_URL=http://localhost:11435
# OLLAMA_MODEL=qwen2.5:3b

# --- OpenRouter (cloud LLM, PR 4) -------------------------------------------
# Required only when LLM_PROVIDER=cloud or a request asks for provider: "cloud".
# Get a free-tier key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
