# Copy this file to .env (repo root) and fill in the values you need.
# .env is gitignored — never commit real secrets.
#
# Docker Compose reads this file automatically for variable substitution in
# docker-compose.yml (e.g. ${GOOGLE_API_KEY:-}).

# --- Google AI Studio key for embeddings and ingestion --------
# Get a free key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# --- Chat models: free-tier models via OpenRouter ---------------------------
# Needed for every chat mode (V3 is cloud-only). Get a free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=           # leave unset to use the default in apps/api-py/models.yaml (also holds the free-model list)

# --- Stage 8.c/8.d guardrails ------------------------------------------------
# GUARD_MODE=rules             # rules (default) | llm (classifier only) | both
# GUARD_MODEL=                 # optional OpenRouter model id for the classifier when GUARD_MODE is llm/both
# SECURITY_AUDIT_RETENTION_DAYS=90
# PII_MODE=off                 # off (default) | detect | redact; needs Presidio, see docs/adr/0024-guard-comparison-and-pii.md
# PII_ENTITIES=CREDIT_CARD,US_SSN,IBAN_CODE,EMAIL_ADDRESS,PHONE_NUMBER

# --- Stage 3.a scale-aware vector search -------------------------------------
# VECTOR_INDEX_MIN_POINTS=10000   # below: exact search; at/above: approximate HNSW
# VECTOR_HNSW_EF=64               # HNSW candidates explored per query (accuracy vs speed)
# VECTOR_COUNT_CACHE_SECONDS=60   # how long the collection size is cached
# QDRANT_COLLECTION=document_chunks   # use document_chunks_demo with scripts/seed_fake_chunks.py

# --- Stage 4 retrieval: hybrid search and an optional reranker ----------------
# RETRIEVAL_MODE=dense          # dense (meaning only, default) | hybrid (meaning + exact words); re-ingest once before hybrid
# RERANK_PROVIDER=off           # off (default) | voyage | cohere. A hosted reranker re-orders the best chunks
# VOYAGE_API_KEY=               # free account at https://www.voyageai.com (first 200M rerank tokens free); only for voyage
# COHERE_API_KEY=               # trial key, 10 requests/min and 1,000 calls/month in total; only for cohere
# RERANK_MODEL=                 # leave unset for the provider's default
# EMBEDDING_PROVIDER=google     # google (default) | fastembed (open-source, optional: `uv sync --extra local-embeddings`; not in the Docker image). Changing it needs one re-ingest
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Stage 10 agent limits ---------------------------------------------------
# AGENT_MAX_STEPS=8            # steps per run (a normal run uses 6; a revision adds 2)
# AGENT_TIMEOUT_SECONDS=180    # whole-run time limit (local CPU model: ~30s per agent call)
# AGENT_MAX_REVISIONS=1        # times the Reviewer agent may send the Analyst agent back
# SUPERVISOR_MAX_TURNS=10      # POST /agent/supervise (E3.1): how often the supervisor may choose who works next

# --- Model gateway (retries and fallback; see apps/api-py/app/llm/gateway.py) --
# LLM_TIMEOUT_SECONDS=60        # how long one model attempt may take
# LLM_MAX_RETRIES=2             # same-model retries for timeouts and server errors (never for a 429)
# LLM_RETRY_MIN_SECONDS=1       # shortest wait before a retry; waits grow from here
# LLM_COOLDOWN_SECONDS=30       # a model that just failed is skipped for this long

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=json              # json (one object per line, request_id on each) or console (readable)

# --- Tracing (Stage 5.1, optional) ---------------------------------------------
# Off by default. Start Langfuse with: docker compose --profile observability up -d
# TRACING_ENABLED=false                         # true: send spans to the endpoint below
# TRACING_ENDPOINT=http://localhost:3000/api/public/otel   # Compose sets http://langfuse-web:3000/... for the API
# LANGFUSE_PUBLIC_KEY=                          # from a Langfuse project (Settings, API keys); never commit them
# LANGFUSE_SECRET_KEY=
# TRACING_CAPTURE_CONTENT=false                 # true also records questions, answers and tool values; keep off for real data
# TRACING_SERVICE_NAME=customer-compass-api
# TRACING_EXPORT_TIMEOUT_SECONDS=5

# --- MCP tool servers (Stage 2.2) --------------------------------------------
# Two servers implement the same tools; the web app's radio buttons choose per request.
# MCP_BACKEND=fastmcp                           # default server: fastmcp (Python) | springboot (Java, Stage 2.2b)
# MCP_FASTMCP_URL=http://localhost:8002/mcp     # Docker Compose sets this for the API; change it only outside Docker
# MCP_SPRINGBOOT_URL=                           # empty: Spring Boot server not configured
# MCP_SERVER_HOST=127.0.0.1                     # where the FastMCP server listens (python -m app.mcp.server)
# MCP_SERVER_PORT=8002
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-fastmcp:*   # Host headers the FastMCP server accepts

# --- Stage 5.4 agentic retrieval ---------------------------------------------------------
# AGENTIC_RETRIEVAL=off        # off (default) | on: check the retrieved passages, retry a weak search once, check the answer's grounding
# Stage 5.5: one setting per seam, manual (default) or frameworks (LangChain / LangGraph prebuilt pieces; an optional install,
# see evals/requirements-frameworks.txt). Nothing changes unless you set one; the gateway and the confirm gate stay manual.
# CHUNKER_IMPL=manual          # manual | frameworks: how a document segment is cut into chunks (ADR 0026)
# RETRIEVAL_IMPL=manual        # manual | frameworks: dense search in Qdrant (ADR 0027); frameworks needs RETRIEVAL_MODE=dense and a re-ingest
# AGENT_IMPL=manual            # manual | frameworks: who picks the evidence tools, our graph or a prebuilt agent (ADR 0028)
# AGENTIC_MODEL=               # optional OpenRouter model id for those checks (the default chat model when unset)
